  "findings": [
    {
      "rule_id": "EG014",
      "rule_name": "invalid-value",
      "severity": "error",
      "message": "LOG_LEVEL in .env has the invalid value verbose: expected one of debug, info, warn or error",
      "variable": "LOG_LEVEL",
      "location": {
        "file": ".env",
        "line": 2,
        "column": 11
      },
      "evidence": "",
      "why": "The app expects LOG_LEVEL to be one of debug, info, warn or error; an invalid value usually crashes it at startup or, worse, is silently misread.",
      "fix": "Set LOG_LEVEL to one of debug, info, warn or error in .env:2. If the schema is wrong, update LOG_LEVEL at .envguard.yaml:7.",
      "related": [
        {
          "file": ".envguard.yaml",
          "line": 7,
          "column": 3
        }
      ],
      "docs_url": "https://github.com/ardamoustafa1/envguard/blob/main/docs/rules/EG014-invalid-value.md"
    },
    {
      "rule_id": "EG005",
      "rule_name": "empty-required-value",
      "severity": "warning",
      "message": "SESSION_SECRET is empty in .env but required by .env.example",
      "variable": "SESSION_SECRET",
      "location": {
        "file": ".env",
        "line": 5,
        "column": 1
      },
      "evidence": "",
      "why": "An empty SESSION_SECRET is usually read as \"set\" and passes presence checks, then fails later (empty URLs, empty credentials, zero ports).",
      "fix": "Set a value for SESSION_SECRET in .env:5. If an empty value is intentional, mark the template line optional: `SESSION_SECRET= # optional` in .env.example:6.",
      "related": [
        {
          "file": ".env.example",
          "line": 6,
          "column": 1
        }
      ],
      "docs_url": "https://github.com/ardamoustafa1/envguard/blob/main/docs/rules/EG005-empty-required-value.md"
    },
    {
      "rule_id": "EG002",
      "rule_name": "undocumented-variable",
      "severity": "warning",
      "message": "FEATURE_NEW_CHECKOUT is set in .env but not documented in any template",
      "variable": "FEATURE_NEW_CHECKOUT",
      "location": {
        "file": ".env",
        "line": 8,
        "column": 1
      },
      "evidence": "",
      "why": "Teammates, CI and deploy targets learn which variables exist from the templates; without an entry, FEATURE_NEW_CHECKOUT will be missing wherever this file is not copied.",
      "fix": "Add `FEATURE_NEW_CHECKOUT=` (with an empty or placeholder value, never the real one) to .env.example, or remove it from .env if nothing uses it.",
      "related": [],
      "docs_url": "https://github.com/ardamoustafa1/envguard/blob/main/docs/rules/EG002-undocumented-variable.md"
    },
    {
      "rule_id": "EG002",
      "rule_name": "undocumented-variable",
      "severity": "warning",
      "message": "CACHE_DIR is set in .env but not documented in any template",
      "variable": "CACHE_DIR",
      "location": {
        "file": ".env",
        "line": 9,
        "column": 1
      },
      "evidence": "",
      "why": "Teammates, CI and deploy targets learn which variables exist from the templates; without an entry, CACHE_DIR will be missing wherever this file is not copied.",
      "fix": "Add `CACHE_DIR=` (with an empty or placeholder value, never the real one) to .env.example, or remove it from .env if nothing uses it.",
      "related": [],
      "docs_url": "https://github.com/ardamoustafa1/envguard/blob/main/docs/rules/EG002-undocumented-variable.md"
    },
    {
      "rule_id": "EG016",
      "rule_name": "unresolved-reference",
      "severity": "warning",
      "message": "CACHE_DIR references APP_HOME, which is not defined in .env or the env files loaded with it",
      "variable": "APP_HOME",
      "location": {
        "file": ".env",
        "line": 9,
        "column": 11
      },
      "evidence": "",
      "why": "Loaders that expand references substitute an empty string for an undefined APP_HOME, so CACHE_DIR silently ends up incomplete (for example a URL without a host).",
      "fix": "Define `APP_HOME=` in .env (checked: .env and .env.example), give the reference a default such as `${APP_HOME:-value}`, or add APP_HOME to scanner.ignore_variables in .envguard.yaml if the process environment provides it.",
      "related": [],
      "docs_url": "https://github.com/ardamoustafa1/envguard/blob/main/docs/rules/EG016-unresolved-reference.md"
    },
    {
      "rule_id": "EG010",
      "rule_name": "possible-secret-in-template",
      "severity": "error",
      "message": "DATABASE_URL in .env.example looks like a URL with an embedded password",
      "variable": "DATABASE_URL",
      "location": {
        "file": ".env.example",
        "line": 4,
        "column": 14
      },
      "evidence": "detected: URL with an embedded password",
      "why": "A template is shared with everyone who can read the repository; a real credential there is leaked, and it stays in git history even after it is removed.",
      "fix": "Replace the value with an empty one or a placeholder (`DATABASE_URL=` or `DATABASE_URL=\u003cyour-value\u003e`). If it is a real credential, rotate it now: it has been exposed. If it is a deliberate fake, use an obvious placeholder or add `# envguard-ignore EG010` on the line above.",
      "related": [],
      "docs_url": "https://github.com/ardamoustafa1/envguard/blob/main/docs/rules/EG010-possible-secret-in-template.md"
    },
    {
      "rule_id": "EG004",
      "rule_name": "declared-but-unused",
      "severity": "info",
      "message": "LEGACY_API_KEY is declared in .env.example but never read by the code, env files, Compose files or workflows",
      "variable": "LEGACY_API_KEY",
      "location": {
        "file": ".env.example",
        "line": 9,
        "column": 1
      },
      "evidence": "",
      "why": "Unused variables make templates longer and send people looking for values nothing needs; they are often left over after a refactor. Note: 1 dynamic lookup in this app (a variable name computed at run time) could not be analyzed and may read it.",
      "fix": "If nothing needs LEGACY_API_KEY, remove it from .env.example:9 and from the real env files. If a tool outside the scanned code reads it (Prisma, Docker, a framework), add LEGACY_API_KEY to scanner.ignore_variables in .envguard.yaml.",
      "related": [],
      "docs_url": "https://github.com/ardamoustafa1/envguard/blob/main/docs/rules/EG004-declared-but-unused.md"
    },
    {
      "rule_id": "EG001",
      "rule_name": "missing-variable",
      "severity": "error",
      "message": "STRIPE_SECRET_KEY is declared in .env.production.example but missing from .env.production",
      "variable": "STRIPE_SECRET_KEY",
      "location": {
        "file": ".env.production",
        "line": 0,
        "column": 0
      },
      "evidence": "",
      "why": "Anything that reads STRIPE_SECRET_KEY in the production environment gets no value, which usually fails only at runtime or silently falls back to a default.",
      "fix": "Add `STRIPE_SECRET_KEY=` to .env.production (it is declared in .env.production.example:2) and set its value. If it is not needed there, mark it optional in the template (`STRIPE_SECRET_KEY= # optional`) or put `# envguard-ignore EG001` on the line above it in .env.production.example.",
      "related": [
        {
          "file": ".env.production.example",
          "line": 2,
          "column": 1
        }
      ],
      "docs_url": "https://github.com/ardamoustafa1/envguard/blob/main/docs/rules/EG001-missing-variable.md"
    },
    {
      "rule_id": "EG015",
      "rule_name": "unsafe-production-value",
      "severity": "warning",
      "message": "REDIS_URL points to a local address in production (.env.production)",
      "variable": "REDIS_URL",
      "location": {
        "file": ".env.production",
        "line": 4,
        "column": 11
      },
      "evidence": "",
      "why": "Inside a production container or server, localhost is the machine itself, not your database or API; this is almost always a development value that slipped through.",
      "fix": "Set REDIS_URL in .env.production to the production host.",
      "related": [],
      "docs_url": "https://github.com/ardamoustafa1/envguard/blob/main/docs/rules/EG015-unsafe-production-value.md"
    },
    {
      "rule_id": "EG014",
      "rule_name": "invalid-value",
      "severity": "error",
      "message": "WORKERS in .env.production has the invalid value 0: is below the minimum 1",
      "variable": "WORKERS",
      "location": {
        "file": ".env.production",
        "line": 6,
        "column": 9
      },
      "evidence": "",
      "why": "The app expects WORKERS to be an integer between 1 and 64; an invalid value usually crashes it at startup or, worse, is silently misread.",
      "fix": "Set WORKERS to an integer between 1 and 64 in .env.production:6. If the schema is wrong, update WORKERS at .envguard.yaml:15.",
      "related": [
        {
          "file": ".envguard.yaml",
          "line": 15,
          "column": 3
        }
      ],
      "docs_url": "https://github.com/ardamoustafa1/envguard/blob/main/docs/rules/EG014-invalid-value.md"
    },
    {
      "rule_id": "EG006",
      "rule_name": "duplicate-key",
      "severity": "warning",
      "message": "DEBUG is defined 2 times in .env.production (lines 7 and 8)",
      "variable": "DEBUG",
      "location": {
        "file": ".env.production",
        "line": 8,
        "column": 1
      },
      "evidence": "line 7: false; line 8: true",
      "why": "Most loaders (dotenv, python-dotenv, Docker) silently use the last definition, so editing the first one has no effect and the file says two different things.",
      "fix": "Keep one definition of DEBUG in .env.production: delete line 8 or the earlier one at line 7, keeping the value you intend.",
      "related": [
        {
          "file": ".env.production",
          "line": 7,
          "column": 1
        }
      ],
      "docs_url": "https://github.com/ardamoustafa1/envguard/blob/main/docs/rules/EG006-duplicate-key.md"
    },
    {
      "rule_id": "EG015",
      "rule_name": "unsafe-production-value",
      "severity": "warning",
      "message": "DEBUG is enabled in production (.env.production)",
      "variable": "DEBUG",
      "location": {
        "file": ".env.production",
        "line": 8,
        "column": 7
      },
      "evidence": "",
      "why": "debug mode in production exposes stack traces, settings and sometimes an interactive console to anyone who triggers an error.",
      "fix": "Set `DEBUG=false` in .env.production.",
      "related": [],
      "docs_url": "https://github.com/ardamoustafa1/envguard/blob/main/docs/rules/EG015-unsafe-production-value.md"
    },
    {
      "rule_id": "EG007",
      "rule_name": "syntax-error",
      "severity": "error",
      "message": "missing '=' after key",
      "variable": "",
      "location": {
        "file": ".env.production",
        "line": 10,
        "column": 8
      },
      "evidence": "",
      "why": "Env loaders skip or misread malformed lines, so the affected variable silently ends up with a wrong value or none at all.",
      "fix": "Write assignments as KEY=value. Keys cannot contain spaces, and a bare 'export KEY' without a value is not supported.",
      "related": [],
      "docs_url": "https://github.com/ardamoustafa1/envguard/blob/main/docs/rules/EG007-syntax-error.md"
    },
    {
      "rule_id": "EG013",
      "rule_name": "environment-drift",
      "severity": "warning",
      "message": "STRIPE_SECRET_KEY is declared for production but not for staging",
      "variable": "STRIPE_SECRET_KEY",
      "location": {
        "file": ".env.production.example",
        "line": 2,
        "column": 1
      },
      "evidence": "",
      "why": "Environments that are supposed to run the same code should need the same variables; a variable documented for only some of them is often forgotten when the next deploy reaches the others.",
      "fix": "Add `STRIPE_SECRET_KEY=` to .env.staging.example, or move it to .env.example if every environment needs it. If it really applies only to production, add `# envguard-ignore EG013` above .env.production.example:2.",
      "related": [],
      "docs_url": "https://github.com/ardamoustafa1/envguard/blob/main/docs/rules/EG013-environment-drift.md"
    },
    {
      "rule_id": "EG013",
      "rule_name": "environment-drift",
      "severity": "warning",
      "message": "STAGING_BANNER is declared for staging but not for production",
      "variable": "STAGING_BANNER",
      "location": {
        "file": ".env.staging.example",
        "line": 2,
        "column": 1
      },
      "evidence": "",
      "why": "Environments that are supposed to run the same code should need the same variables; a variable documented for only some of them is often forgotten when the next deploy reaches the others.",
      "fix": "Add `STAGING_BANNER=` to .env.production.example, or move it to .env.example if every environment needs it. If it really applies only to staging, add `# envguard-ignore EG013` above .env.staging.example:2.",
      "related": [],
      "docs_url": "https://github.com/ardamoustafa1/envguard/blob/main/docs/rules/EG013-environment-drift.md"
    },
    {
      "rule_id": "EG012",
      "rule_name": "ci-secret-undocumented",
      "severity": "info",
      "message": "workflows use secret FLY_API_TOKEN, but no template or schema documents it",
      "variable": "FLY_API_TOKEN",
      "location": {
        "file": ".github/workflows/deploy.yml",
        "line": 14,
        "column": 30
      },
      "evidence": "",
      "why": "Whoever sets up a fork, a new environment or a new repository has to discover FLY_API_TOKEN by reading workflow files; a missing one usually shows up as a failed deploy.",
      "fix": "Document it: add `FLY_API_TOKEN=` to .env.example with a comment such as `# CI: set in GitHub → Settings → Secrets and variables → Actions (Secrets tab)`, or declare it under `variables:` in .envguard.yaml.",
      "related": [],
      "docs_url": "https://github.com/ardamoustafa1/envguard/blob/main/docs/rules/EG012-ci-secret-undocumented.md"
    },
    {
      "rule_id": "EG012",
      "rule_name": "ci-secret-undocumented",
      "severity": "info",
      "message": "workflows use variable DEPLOY_REGION, but no template or schema documents it",
      "variable": "DEPLOY_REGION",
      "location": {
        "file": ".github/workflows/deploy.yml",
        "line": 15,
        "column": 30
      },
      "evidence": "",
      "why": "Whoever sets up a fork, a new environment or a new repository has to discover DEPLOY_REGION by reading workflow files; a missing one usually shows up as a failed deploy.",
      "fix": "Document it: add `DEPLOY_REGION=` to .env.example with a comment such as `# CI: set in GitHub → Settings → Secrets and variables → Actions (Variables tab)`, or declare it under `variables:` in .envguard.yaml.",
      "related": [],
      "docs_url": "https://github.com/ardamoustafa1/envguard/blob/main/docs/rules/EG012-ci-secret-undocumented.md"
    },
    {
      "rule_id": "EG011",
      "rule_name": "compose-undefined-variable",
      "severity": "warning",
      "message": "docker-compose.yml interpolates ${POSTGRES_PASSWORD}, which is not defined in .env (the file Compose reads) or any template",
      "variable": "POSTGRES_PASSWORD",
      "location": {
        "file": "docker-compose.yml",
        "line": 17,
        "column": 28
      },
      "evidence": "",
      "why": "Compose substitutes an empty string for an unset POSTGRES_PASSWORD and only prints a warning, so the container starts with a broken value.",
      "fix": "Add `POSTGRES_PASSWORD=` with a value to .env and document it in a template, or give it a default in the Compose file: `${POSTGRES_PASSWORD:-value}`.",
      "related": [],
      "docs_url": "https://github.com/ardamoustafa1/envguard/blob/main/docs/rules/EG011-compose-undefined-variable.md"
    },
    {
      "rule_id": "EG003",
      "rule_name": "used-but-undeclared",
      "severity": "error",
      "message": "ANALYTICS_WRITE_KEY is read by the code but not declared in any env file, template or schema",
      "variable": "ANALYTICS_WRITE_KEY",
      "location": {
        "file": "src/server.js",
        "line": 23,
        "column": 33
      },
      "evidence": "",
      "why": "Nothing documents that ANALYTICS_WRITE_KEY must be set, so a new environment or teammate will not provide it and the code reads an empty value at runtime.",
      "fix": "Add `ANALYTICS_WRITE_KEY=` to .env.example (read at src/server.js:23), then set it in each real env file. If the platform provides it, add ANALYTICS_WRITE_KEY to scanner.ignore_variables in .envguard.yaml.",
      "related": [],
      "docs_url": "https://github.com/ardamoustafa1/envguard/blob/main/docs/rules/EG003-used-but-undeclared.md"
    },
    {
      "rule_id": "EG003",
      "rule_name": "used-but-undeclared",
      "severity": "info",
      "message": "WORKER_CONCURRENCY is read by the code but not declared in any env file, template or schema",
      "variable": "WORKER_CONCURRENCY",
      "location": {
        "file": "worker/main.py",
        "line": 6,
        "column": 30
      },
      "evidence": "",
      "why": "The code falls back to a default, so nothing breaks if WORKER_CONCURRENCY is unset, but it is invisible to anyone configuring the app and the default may be wrong for production.",
      "fix": "Document it by adding `WORKER_CONCURRENCY= # optional` to .env.example (read at worker/main.py:6). If you do not want it documented, add WORKER_CONCURRENCY to scanner.ignore_variables in .envguard.yaml.",
      "related": [],
      "docs_url": "https://github.com/ardamoustafa1/envguard/blob/main/docs/rules/EG003-used-but-undeclared.md"
    }
