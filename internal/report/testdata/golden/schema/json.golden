      "rule_id": "EG002",
      "rule_name": "undocumented-variable",
      "severity": "warning",
      "message": "NODE_ENV is set in negative/.env.development but not documented in any template",
      "variable": "NODE_ENV",
      "location": {
        "file": "negative/.env.development",
        "line": 2,
        "column": 1
      },
      "evidence": "",
      "why": "Teammates, CI and deploy targets learn which variables exist from the templates; without an entry, NODE_ENV will be missing wherever this file is not copied.",
      "fix": "Add `NODE_ENV=` (with an empty or placeholder value, never the real one) to negative/.env.example, or remove it from negative/.env.development if nothing uses it.",
      "related": [],
      "docs_url": "https://github.com/ardamoustafa1/envguard/blob/main/docs/rules/EG002-undocumented-variable.md"
    },
