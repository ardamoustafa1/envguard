# full-line comment
   # indented comment
URL=https://example.com/path?a=1&b=2#fragment
PASSWORD_LIKE=abc#123
WITH_COMMENT=value # this is a comment
TAB_COMMENT=value	# tab before hash
QUOTED_HASH="a # b" # real comment
SINGLE_HASH='x#y'#tight comment
EMPTY_COMMENT= # only a comment
HASH_FIRST=#notacomment
