# Local development configuration. `cp .env.example .env`

# General
APP_ENV=development
LOG_LEVEL=info
JWT_SECRET=dev-only-secret
APP_VERSION= # optional

# HTTP server
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=15s

# Database
DB_URL=postgres://app:app@localhost:5432/app?sslmode=disable
DB_MAX_CONNS=10
TEST_DATABASE_URL=postgres://app:app@localhost:5432/app_test?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_TTL=5m

# Overrides
LOG_LEVEL=debug
