# Copy to .env.local and fill in. See README for details.

# --- Database ---------------------------------------------------------
# Prisma connection string (Postgres)
DATABASE_URL=postgresql://app:app@localhost:5432/acme

# --- Auth.js ----------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000
AUTH_GITHUB_ID=your-github-oauth-client-id
AUTH_GITHUB_SECRET=your-github-oauth-client-secret

# --- Stripe -----------------------------------------------------------
STRIPE_SECRET_KEY=change-me
STRIPE_WEBHOOK_SECRET=change-me

# --- Public (exposed to the browser) ---------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_POSTHOG_KEY= # optional

# Set to 1 to skip env validation (e.g. in Docker builds)
SKIP_ENV_VALIDATION= # optional
