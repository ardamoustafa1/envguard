# Copy to .env for local development (loaded by dotenv-rails).

# --- Server ---
PORT=3000
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2
RAILS_LOG_LEVEL=debug
APP_HOST=localhost:3000
CORS_ORIGINS=http://localhost:5173
FORCE_SSL=false

# --- Database ---
DB_HOST=localhost
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Production only
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledgerly_production

# --- Redis / Sidekiq ---
REDIS_URL=redis://localhost:6379/0
SIDEKIQ_CONCURRENCY=5
SIDEKIQ_WEB_USERNAME=admin
SIDEKIQ_WEB_PASSWORD=change-me

# --- Mail ---
MAILER_FROM=billing@example.com
SMTP_ADDRESS=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Storage (production) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=

# --- Monitoring ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
GIT_SHA=

# --- Rails ---
# Only needed in production: the contents of config/master.key
RAILS_MASTER_KEY=
